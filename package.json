{
	"name": "karaudio-admin",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"lint": "ng lint",
		"lint:fix": "ng lint --fix",
		"stylelint": "stylelint \"src/**/*.scss\"",
		"stylelint:fix": "stylelint \"src/**/*.scss\" --fix",
		"format": "prettier --write \"**/*.{js,ts,json,scss,html,md}\"",
		"format:check": "prettier --check \"**/*.{js,ts,json,scss,html,md}\"",
		"type-check": "tsc --noEmit",
		"prepare": "husky"
	},
	"private": true,
	"packageManager": "npm@11.1.0",
	"dependencies": {
		"@angular/cdk": "^21.0.5",
		"@angular/common": "^22.0.4",
		"@angular/compiler": "^22.0.4",
		"@angular/core": "^22.0.4",
		"@angular/forms": "^22.0.4",
		"@angular/material": "^21.0.5",
		"@angular/platform-browser": "^22.0.4",
		"@angular/platform-server": "^22.0.4",
		"@angular/router": "^22.0.4",
		"@ngx-translate/core": "^17.0.0",
		"@ngx-translate/http-loader": "^17.0.0",
		"@tailwindcss/postcss": "^4.1.18",
		"express": "^5.1.0",
		"postcss": "^8.5.6",
		"rxjs": "~7.8.0",
		"tailwindcss": "^4.1.18",
		"tslib": "^2.3.0"
	},
	"devDependencies": {
		"@angular/build": "^22.0.4",
		"@angular/cli": "^22.0.4",
		"@angular/compiler-cli": "^22.0.4",
		"@types/express": "^5.0.1",
		"@types/node": "^20.17.19",
		"angular-eslint": "21.1.0",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"husky": "^9.1.7",
		"jsdom": "^27.1.0",
		"lint-staged": "^16.2.7",
		"postcss": "^8.5.3",
		"prettier": "^3.7.4",
		"stylelint": "^16.26.1",
		"stylelint-config-standard-scss": "^16.0.0",
		"stylelint-config-tailwindcss": "^1.0.0",
		"stylelint-order": "^7.0.0",
		"stylelint-scss": "^6.13.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "8.47.0",
		"vitest": "^4.0.8"
	},
	"lint-staged": {
		"*.{js,ts,html,scss,json,md}": [
			"prettier --write"
		],
		"*.ts": [
			"eslint"
		],
		"*.scss": [
			"stylelint"
		]
	}
}
